---
// Renders install actions derived by getInstallActions. A download button
// appears only when the snapshot proves a real public asset (assetUrl +
// version/revision + checksum + disclosed signing state). An available-but-
// unsigned artifact still renders as a real download, with its unsigned
// warning shown next to the button. Unavailable or incomplete distributions
// render as static explanatory text — never as a click target that pretends to
// install something.
import { getInstallActions, type ProductSnapshot } from "../lib/product-content";

interface Props {
  snapshot: ProductSnapshot;
}

const { snapshot } = Astro.props;
const actions = getInstallActions(snapshot);
const links = actions.filter((a) => a.notice === null);
const notices = actions.filter((a) => a.notice !== null);
---
<div class="actions" aria-label="Install Babel">
  {links.map((action) => (
    <div class="action">
      <a class={`button ${action.kind === "source" ? "primary" : "secondary"}`} href={action.href}>
        {action.label}
      </a>
      {action.warning && <p class="action-warning">{action.warning}</p>}
    </div>
  ))}
</div>
{notices.length > 0 && (
  <ul class="install-notices">
    {notices.map((action) => (
      <li>
        <strong>{action.label}:</strong> {action.notice}
        See <a href="/status/">status</a> for evidence.
      </li>
    ))}
  </ul>
)}
