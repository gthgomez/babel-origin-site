---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import InstallActions from "../components/InstallActions.astro";
import { parseProductSnapshot } from "../lib/product-content";
import snapshotData from "../data/product-status.json";

const snapshot = parseProductSnapshot(snapshotData);
const others = snapshot.distributions.filter((d) => d.kind !== "source");
const installer = others.find(d => d.id === "desktop-windows-setup" && d.availability === "available");
const AVAILABILITY: Record<string, string> = {
  available: "Available",
  not_available: "Not available",
  unknown: "Unknown",
};
---
<MarketingLayout
  title="Get Babel — download"
  description="Download Babel for Windows or build from source. Published assets include version, checksum, and signing status."
  canonicalPath="/download"
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Get Babel</p>
      <h1>{installer ? "Install Babel Desktop." : "Install Babel from source."}</h1>
      {installer ? <p class="lede">Download the Windows installer, run setup, open a project, and choose your provider and models. The installer includes the Babel CLI and Node runtime. Start Docker Desktop before running tasks.</p> : <p class="lede">Build Babel from source, or use an available Windows portable package listed below. Each published download includes its exact version, checksum and signing status.</p>}
      <InstallActions snapshot={snapshot} />
      <p class="fine-print">Babel has no published npm package. Use a published download below or build from source.</p>
      {installer && <p><a href="/docs/interfaces/desktop/">Desktop setup guide</a> · Cloud providers require your API key and may charge for tasks.</p>}
    </div>
  </section>

  <section class="band">
    <div class="section-heading">
      <h2>Source installation</h2>
    </div>
    <p>
      Requirements: Node.js 22.19+ (22.x line) or 24.13.1+ (24.x line), Git,
      and — for model sessions — a provider key. Full steps in the
      <a href="/docs/getting-started/install/">installation guide</a>:
    </p>
    <pre class="install-commands"><code>git clone https://github.com/gthgomez/Babel.git
cd Babel
npm --prefix ./babel-cli ci &amp;&amp; npm --prefix ./babel-cli run build
node ./babel-cli/dist/index.js doctor</code></pre>
  </section>

  <section class="band">
    <div class="section-heading">
      <p class="eyebrow">Distribution status</p>
      <h2>What is (and is not) published</h2>
    </div>
    <div class="card-grid">
      {others.map((dist) => (
        <article class="card">
          <span class={`status-pill ${dist.availability === "available" ? "released" : ""}`}>
            {AVAILABILITY[dist.availability]}
          </span>
          <h3>{dist.label}</h3>
          {dist.version && <p><code>{dist.version}</code></p>}
          {dist.availability === "available" && dist.assetUrl && (
            <p><a href={dist.assetUrl}>Download {dist.version ?? "published asset"} from GitHub</a></p>
          )}
          {dist.availability === "available" && dist.checksum && (
            <p class="checksum"><strong>Checksum:</strong> <code>{dist.checksum}</code></p>
          )}
          <p>{dist.reason ?? ""}</p>
          {dist.signingState === "unsigned" && (
            <p><strong>Signing:</strong> unsigned.</p>
          )}
        </article>
      ))}
    </div>
    <p>
      See <a href="/status/">status</a> for the evidence behind each record.
      An available binary distribution is a real GitHub-hosted asset with a
      disclosed checksum; for an unsigned Windows package, verify the SHA256
      against the matching release checksum file before running it:
      <code>.exe.sha256</code> for Setup.exe or <code>SHA256SUMS</code> for the ZIP.
    </p>
  </section>
</MarketingLayout>

<style>
  .install-commands {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 16px;
    overflow-x: auto;
    font-size: 0.9rem;
  }
  .checksum code {
    overflow-wrap: anywhere;
    font-size: 0.8rem;
  }
</style>
