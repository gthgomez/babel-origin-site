---
import MarketingLayout from "../layouts/MarketingLayout.astro";

// T06 finishes this page with full Chat/Plan/Deep/Evidence sections. The
// reference label is load-bearing and must survive every later edit.
---
<MarketingLayout
  title="Product tour — Babel"
  description="A labeled walkthrough of the Babel Harness interface and workflow. Illustrative reference content, not a live run."
  canonicalPath="/tour"
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Product tour</p>
      <h1>See how Babel works, before you run it.</h1>
      <p class="lede">
        This is an accessible, clearly labeled walkthrough of the interface and
        workflow. Everything below is illustrative reference content — not a
        live session and not captured execution output.
      </p>
      <p><span class="reference-label">Reference preview</span> not a live run</p>
    </div>
  </section>
</MarketingLayout>
